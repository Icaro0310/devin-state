__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
dist/
build/
.env
*.db
*.db-shm
*.db-wal

# Local session state — never committed
.devin/

# devin-doctor writes its machine snapshot to cwd — contains absolute
# paths, cron commands and unit names; never commit
doctor/automation-snapshot.json

# Test fixtures are committed on purpose (all secrets are planted fakes)
!**/tests/fixtures/.env
!**/tests/fixtures/*.db
